<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Sunrise Dental Clinic</display-name>
    <description>Advanced Patient and Appointment Management System</description>

    <!-- ============================================================
         WELCOME FILE
         ============================================================ -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- ============================================================
         SESSION CONFIGURATION
         30 minutes session timeout
         ============================================================ -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- ============================================================
         FILTERS
         ============================================================ -->

    <!-- Authentication Filter -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>lk.sunrise.dental.filter.AuthFilter</filter-class>
    </filter>

    <!-- Apply AuthFilter to all URLs except login/assets -->
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ============================================================
         SERVLETS
         ============================================================ -->

    <!-- Home Servlet -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>lk.sunrise.dental.servlet.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <!-- Login Servlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>lk.sunrise.dental.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- Logout Servlet -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>lk.sunrise.dental.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Dashboard Servlet -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>lk.sunrise.dental.servlet.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <!-- Patient Servlet -->
    <servlet>
        <servlet-name>PatientServlet</servlet-name>
        <servlet-class>lk.sunrise.dental.servlet.PatientServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PatientServlet</servlet-name>
        <url-pattern>/patients</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PatientServlet</servlet-name>
        <url-pattern>/patients/*</url-pattern>
    </servlet-mapping>

    <!-- Appointment Servlet -->
    <servlet>
        <servlet-name>AppointmentServlet</servlet-name>
        <servlet-class>lk.sunrise.dental.servlet.AppointmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AppointmentServlet</servlet-name>
        <url-pattern>/appointments</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppointmentServlet</servlet-name>
        <url-pattern>/appointments/*</url-pattern>
    </servlet-mapping>

    <!-- Bill Servlet -->
    <servlet>
        <servlet-name>BillServlet</servlet-name>
        <servlet-class>lk.sunrise.dental.servlet.BillServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BillServlet</servlet-name>
        <url-pattern>/bills</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BillServlet</servlet-name>
        <url-pattern>/bills/*</url-pattern>
    </servlet-mapping>

    <!-- Staff Servlet -->
    <servlet>
        <servlet-name>StaffServlet</servlet-name>
        <servlet-class>lk.sunrise.dental.servlet.StaffServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StaffServlet</servlet-name>
        <url-pattern>/staff</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>StaffServlet</servlet-name>
        <url-pattern>/staff/*</url-pattern>
    </servlet-mapping>

    <!-- Report Servlet -->
    <servlet>
        <servlet-name>ReportServlet</servlet-name>
        <servlet-class>lk.sunrise.dental.servlet.ReportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReportServlet</servlet-name>
        <url-pattern>/reports</url-pattern>
    </servlet-mapping>

    <!-- Help Servlet -->
    <servlet>
        <servlet-name>HelpServlet</servlet-name>
        <servlet-class>lk.sunrise.dental.servlet.HelpServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HelpServlet</servlet-name>
        <url-pattern>/help</url-pattern>
    </servlet-mapping>

    <!-- ============================================================
         REST/JSON API - distributed web service layer, consumable
         independently of the JSP UI (e.g. a mobile app, Postman, or
         a third-party integration), authenticated via the same
         session cookie as the browser-facing pages.
         ============================================================ -->

    <!-- Patient API -->
    <servlet>
        <servlet-name>PatientApiServlet</servlet-name>
        <servlet-class>lk.sunrise.dental.api.PatientApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PatientApiServlet</servlet-name>
        <url-pattern>/api/patients</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PatientApiServlet</servlet-name>
        <url-pattern>/api/patients/*</url-pattern>
    </servlet-mapping>

    <!-- Appointment API -->
    <servlet>
        <servlet-name>AppointmentApiServlet</servlet-name>
        <servlet-class>lk.sunrise.dental.api.AppointmentApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AppointmentApiServlet</servlet-name>
        <url-pattern>/api/appointments</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppointmentApiServlet</servlet-name>
        <url-pattern>/api/appointments/*</url-pattern>
    </servlet-mapping>

    <!-- Bill API -->
    <servlet>
        <servlet-name>BillApiServlet</servlet-name>
        <servlet-class>lk.sunrise.dental.api.BillApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BillApiServlet</servlet-name>
        <url-pattern>/api/bills</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BillApiServlet</servlet-name>
        <url-pattern>/api/bills/*</url-pattern>
    </servlet-mapping>

    <!-- Treatment API (read-only) -->
    <servlet>
        <servlet-name>TreatmentApiServlet</servlet-name>
        <servlet-class>lk.sunrise.dental.api.TreatmentApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TreatmentApiServlet</servlet-name>
        <url-pattern>/api/treatments</url-pattern>
    </servlet-mapping>

    <!-- Report API (stored-procedure-backed analytics, admin only) -->
    <servlet>
        <servlet-name>ReportApiServlet</servlet-name>
        <servlet-class>lk.sunrise.dental.api.ReportApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReportApiServlet</servlet-name>
        <url-pattern>/api/reports/*</url-pattern>
    </servlet-mapping>

    <!-- ============================================================
         ERROR PAGES
         ============================================================ -->
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/error/403.jsp</location>
    </error-page>

    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error/404.jsp</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>

</web-app>