# ================================================================
# Sunrise Dental Clinic - runtime configuration TEMPLATE
#
# Copy this file to "app.properties" in the same folder and fill in
# your own real values. "app.properties" is gitignored on purpose so
# real credentials are never pushed to a public repository.
# ================================================================

# ── Database ────────────────────────────────────────────────────
db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/sunrise_dental_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Colombo&characterEncoding=UTF-8
db.user=root
db.password=CHANGE_ME

# ── Email (any SMTP provider - Mailtrap sandbox recommended for testing) ──
smtp.host=sandbox.smtp.mailtrap.io
smtp.port=2525
smtp.username=CHANGE_ME
smtp.password=CHANGE_ME
smtp.from.email=noreply@sunrisedental.lk
smtp.from.name=Sunrise Dental Clinic
